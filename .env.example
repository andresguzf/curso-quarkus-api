# Copia este archivo como .env y completa los valores reales.
# Quarkus lee el .env de la raíz del proyecto automáticamente.

# ===== PostgreSQL =====
# dev: DB_USERNAME y DB_PASSWORD son las credenciales del contenedor quarkusapi-postgres
#      (compose-devservices.yml); la URL la arma Quarkus: jdbc:postgresql://localhost:5432/quarkusapi.
# prod: DB_URL, DB_USERNAME y DB_PASSWORD apuntan a la base real.
DB_URL=jdbc:postgresql://localhost:5432/quarkusapi
DB_USERNAME=tu-usuario
DB_PASSWORD=tu-password

# ===== pgAdmin (compose-devservices.yml) =====
# Login de pgAdmin en http://localhost:5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=tu-password-pgadmin
