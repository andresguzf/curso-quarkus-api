# Copia este archivo como .env y completa los valores reales.
# Quarkus lee el .env de la raíz del proyecto automáticamente.

# ===== PostgreSQL (Supabase) =====
# dev y prod usan Supabase: botón Connect > JDBC > Session pooler (IPv4). test crea un PostgreSQL temporal.
DB_URL=jdbc:postgresql://aws-0-tu-region.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.tu-project-ref
DB_PASSWORD=tu-password-de-supabase

# ===== pgAdmin (compose-devservices.yml) =====
# Login de pgAdmin en http://localhost:5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=tu-password-pgadmin

# ===== Seguridad =====
# Admin inicial: se crea al arrancar si no existe ningún admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=tu-password-admin
# prod: claves PEM para firmar y verificar el JWT, relativas a la raíz (en dev y test Quarkus las genera en memoria).
# Se generan una vez en keys/ (ignorada por git); ver "Empaquetar y ejecutar" en el README.
JWT_PRIVATE_KEY_LOCATION=keys/privateKey.pem
JWT_PUBLIC_KEY_LOCATION=keys/publicKey.pem
# prod: cookies access_token y csrf-token con Secure (solo HTTPS). false solo para el jar en local por http;
# en un servidor real con HTTPS se borra o se deja en true
COOKIE_SECURE=false
